{
  "name": "ctc-scheduler",
  "author": "Sebastian Mach",
  "version": "1.0.0",
  "description": "Scheduler for creating calls",
  "scripts": {
    "build": "rimraf build && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "postinstall": "rimraf build && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:watch": "nodemon --watch src --watch config --exec \"ts-node -r tsconfig-paths/register\" src/main.ts",
    "start": "node build/src/main",
    "lint": "eslint \"**/*.+(ts|js)\" --fix"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cors": "^2.8.5",
    "debug": "^4.3.4",
    "dotenv": "^16.0.0",
    "express": "^4.22.3",
    "mysql": "^2.18.1",
    "node-cache": "^5.1.2",
    "redis": "^3.1.2",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "tslib": "^2.8.1",
    "typeorm": "^0.2.45",
    "winston": "^3.7.2"
  },
  "devDependencies": {
    "@types/debug": "^4.1.7",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/redis": "^2.8.32",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^2.6.2",
    "rimraf": "^6.1.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3"
  }
}
